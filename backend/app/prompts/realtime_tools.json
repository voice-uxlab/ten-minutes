[
  {
    "type": "function",
    "name": "review_question",
    "description": "고민과 필요한 관점을 정리하고 말로 질문의 취지를 확인할 준비를 한다. 배치는 네 유형 중 사연에 맞춰 내부적으로 정하고 장수는 항상 3장으로 고정하며 사용자에게 고르게 하지 않는다. 선택지 비교는 choices에 실제 두 선택을 넣는다.",
    "parameters": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "spreadId": {
          "type": "string",
          "enum": [
            "timeline",
            "situation",
            "relationship",
            "decision"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "timeframe": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "spreadId"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "confirm_question",
    "description": "사용자가 질문에 동의했거나 이미 해당 상황으로 봐달라고 명확히 요청했으면 번호 선택을 시작한다. 같은 요청을 다시 승인받지 않는다.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "select_numbers",
    "description": "번호를 들을 때마다 누적한다. 일부만 말해도 즉시 호출하고 remaining만큼 더 요청한다. replace는 명시적인 수정에만 사용한다.",
    "parameters": {
      "type": "object",
      "properties": {
        "picks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "replace": {
          "type": "boolean"
        }
      },
      "required": [
        "picks"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "confirm_cards",
    "description": "필요한 번호가 모두 모이고 사용자가 번호를 확인했을 때만 확정한다.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "reveal_card",
    "description": "확정한 카드를 자리 순서대로 공개한다. 실제 카드 이름과 정역은 결과만 따른다.",
    "parameters": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "slot"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "show_reading",
    "description": "현재 공개한 카드 한 장의 해석 근거를 받는다. slot 1, 2, 3을 각각 사용한다. 해당 카드 설명 후 사용자 생각을 묻고 실제 답변을 받은 다음에만 다음 reveal_card를 호출한다. 세 장의 개별 해석이 끝나면 slot:0으로 짧게 마무리한다.",
    "parameters": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "end_call",
    "description": "사용자가 종료를 요청하거나 마지막 인사를 마치면 통화를 끝낸다.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
]
