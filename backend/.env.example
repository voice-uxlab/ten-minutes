APP_ENV=local
BACKEND_ORIGIN=http://localhost:8000
PUBLIC_WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ten_minutes
SESSION_COOKIE_SECURE=false

# Kakao / Naver OAuth (OpenAI login is intentionally unsupported.)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Voice providers. Endpoints return 503 until their credentials are configured.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
